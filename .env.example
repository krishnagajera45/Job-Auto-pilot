# Job Autopilot Configuration (.env)
# Copy this file to .env and fill in actual values

# ========================================
# LLM Configuration (Ollama)
# ========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# ========================================
# APIs & External Services
# ========================================

# Brave Search API
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Twilio WhatsApp Integration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+1234567890

# Mem0 (Memory Management)
MEM0_API_KEY=your_mem0_api_key_here

# LangSmith (Observability)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=job-autopilot

# ========================================
# Database
# ========================================
DATABASE_URL=sqlite:///./job_autopilot.db

# For PostgreSQL in production:
# DATABASE_URL=******localhost:5432/job_autopilot

# ========================================
# Scheduling
# ========================================
SCHEDULED_SEARCH_TIME=12:00
SCHEDULED_SEARCH_QUERY=Senior Software Engineer roles in tech hubs

# ========================================
# Application Settings
# ========================================
DEBUG=False
LOG_LEVEL=INFO

# ========================================
# Feature Flags
# ========================================
ENABLE_MEM0=True
ENABLE_LANGSMITH=True
USE_MOCK_MCP_TOOLS=True
