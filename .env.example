# Environment
ENVIRONMENT=development

# Core auth config
AUTH_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
OPENCLAW_CONFIG_PATH=/app/configs/openclaw.json

# Database
POSTGRES_USER=jobautopilot
POSTGRES_PASSWORD=jobautopilot
POSTGRES_DB=jobautopilot

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional integrations
GROQ_API_KEY=
OPENAI_API_KEY=
CLOUD_API_KEY=
CLOUD_MODEL=
LANGSMITH_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://rabbitmq:5672
JOB_FETCH_PROXY_URL=https://r.jina.ai/http://

# Messaging channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
